  "tokenColors": [
    // ===== YOUR ADDED RULES (appended, highest priority if placed first manually) =====
    {
      "name": "[User] Template Expression",
      "scope": ["meta.template.expression", "meta.jsx.expression"],
      "settings": {
        "foreground": "#4FC1FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "[User] Template Punctuation",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded.begin.jsx",
        "punctuation.section.embedded.end.jsx"
      ],
      "settings": {
        "foreground": "#FFD700"
      }
    },
    {
      "name": "[User] JSX Text",
      "scope": ["meta.jsx.children", "string.jsx"],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "[User] Interface",
      "scope": ["entity.name.type.interface"],
      "settings": {
        "foreground": "#FF6B6B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "[User] Type",
      "scope": ["entity.name.type"],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "name": "[User] Property",
      "scope": ["variable.other.property"],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "name": "[User] Variable (semantic approx)",
      "scope": ["variable"],
      "settings": {
        "foreground": "#303eff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "[User] Parameter (semantic approx)",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#eeff00",
        "fontStyle": "italic"
      }
    },
    {
      "name": "[User] Class (semantic approx)",
      "scope": ["entity.name.type.class"],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },

    // ===== ORIGINAL TOKEN COLORS (unchanged, truncated here for brevity) =====
    {
      "scope": "source",
      "settings": {
        "foreground": "#a9e9df"
      }
    }
    // 👉 KEEP the rest of your original tokenColors exactly as-is below this
  ]
}
